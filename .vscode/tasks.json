{
    "version": "2.0.0",
    "tasks": [
        {
            // No-install preview of the Django pages (preview.ps1). Skips itself if port 8000 is already in use.
            "label": "Preview site, no Python (port 8000)",
            "type": "shell",
            "command": "if (Get-NetTCPConnection -LocalPort 8000 -State Listen -ErrorAction SilentlyContinue) { Write-Host 'ScoreLine is running at http://localhost:8000/ (server already running)' } else { powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\preview.ps1\" }",
            "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
            "isBackground": true,
            "problemMatcher": {
                "owner": "scoreline-preview",
                "pattern": { "regexp": "^__never_matches__$" },
                "background": { "activesBegin": ".", "beginsPattern": ".", "endsPattern": "ScoreLine is running at" }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        },
        {
            // Starts the Django site on port 8000 (needs Python + `pipenv install` in Django/, see README).
            // Skips itself if something is already listening on 8000, so F5 works either way.
            "label": "Run Django (port 8000)",
            "type": "shell",
            "command": "if (Get-NetTCPConnection -LocalPort 8000 -State Listen -ErrorAction SilentlyContinue) { Write-Host 'Quit the server with CTRL-BREAK (already running on http://localhost:8000/)' } else { pipenv run python manage.py runserver 8000 }",
            "options": {
                "cwd": "${workspaceFolder}/Django",
                "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "scoreline-django",
                "pattern": { "regexp": "^__never_matches__$" },
                "background": {
                    "activesBegin": ".",
                    "beginsPattern": ".",
                    "endsPattern": "Quit the server with"
                }
            },
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
