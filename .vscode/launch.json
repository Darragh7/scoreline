{
    // Press F5: starts Django (task "Run Django (port 8000)") and opens the site.
    // Needs Python and `pipenv install` in the Django folder first (see README).
    "version": "0.2.0",
    "configurations": [
        {
            // Works without Python: builds and serves a preview copy of the Django pages (preview.ps1)
            "type": "msedge",
            "request": "launch",
            "name": "ScoreLine: preview without Python (Edge)",
            "url": "http://localhost:8000/",
            "webRoot": "${workspaceFolder}/.preview",
            "preLaunchTask": "Preview site, no Python (port 8000)"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "ScoreLine: Chrome (localhost:8000)",
            "url": "http://localhost:8000/",
            "webRoot": "${workspaceFolder}/Django/ScoreLine/static",
            "preLaunchTask": "Run Django (port 8000)"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "ScoreLine: Edge (localhost:8000)",
            "url": "http://localhost:8000/",
            "webRoot": "${workspaceFolder}/Django/ScoreLine/static",
            "preLaunchTask": "Run Django (port 8000)"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "ScoreLine: Chrome, open the predictor",
            "url": "http://localhost:8000/predictor.html",
            "webRoot": "${workspaceFolder}/Django/ScoreLine/static",
            "preLaunchTask": "Run Django (port 8000)"
        }
    ]
}
